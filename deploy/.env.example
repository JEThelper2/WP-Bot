# Copy to deploy/.env (docker compose -f deploy/docker-compose.yml loads it
# automatically). All values optional — the stack runs without them, just
# degraded (see below).

# ---- WhatsApp Cloud API -------------------------------------------------
# WHATSAPP_VERIFY_TOKEN: token Meta sends in the webhook handshake.
# WHATSAPP_APP_SECRET:   app secret; enables X-Hub-Signature-256 delivery
#                        verification (forged deliveries rejected with 403).
# WHATSAPP_API_TOKEN:    system-user access token (media download + send).
# WHATSAPP_PHONE_NUMBER_ID: business phone number id for outbound messages.
WHATSAPP_VERIFY_TOKEN=wp-bot-dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---- LLM intent parsing --------------------------------------------------
# Without OPENAI_API_KEY every request is treated as low-confidence and
# the bot asks a clarifying question instead of confirming a publish.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Track B secrets ------------------------------------------------------
# Base64 Fernet key used to encrypt stored WordPress application
# passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, Track B uses a per-process dev key (credentials become
# undecryptable after restart).
WPBOT_SECRETS_KEY=
