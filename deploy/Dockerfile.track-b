# WP-Bot Track B — WordPress site/state service.
#
# Build context is the REPO ROOT (shared-contract + track-b must both be
# present). The [postgres] extra installs asyncpg so the PRD §11 change
# log uses Postgres in production.
FROM python:3.12-slim

WORKDIR /app

COPY shared-contract ./shared-contract
COPY track-b ./track-b

RUN pip install --no-cache-dir ./shared-contract \
 && pip install --no-cache-dir "./track-b[postgres]"

EXPOSE 8200
CMD ["uvicorn", "track_b.main:app", "--host", "0.0.0.0", "--port", "8200"]
